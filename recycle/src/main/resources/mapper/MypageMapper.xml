<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="first_project.recycle.repository.MypageMapper">

    <!-- 1. memberId로 단건 조회 -->
    <select id="findById" resultType="first_project.recycle.domain.Member">
        SELECT *
        FROM member
        WHERE member_id = #{memberId}
    </select>

    <!-- 2. memberId로 회원정보 수정 -->
    <update id="updateMember">
        UPDATE member
        <set>
            nickname = #{info.nickname},
            <if test="info.newpassword != null and info.newpassword != ''">
                password = #{info.newpassword},
            </if>
        </set>
        WHERE member_id = #{memberId}
    </update>

    <!-- 3. memberId로 삭제 -->
    <delete id="deleteById">
        DELETE FROM member
        WHERE member_id = #{memberId}
    </delete>

</mapper>